# Force LF endings for source and config — keeps Go build tags, shell
# scripts, and YAML parsers happy when the repo is cloned on Windows with
# core.autocrlf=true.
*.go        text eol=lf
*.sh        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
Makefile    text eol=lf
go.mod      text eol=lf
go.sum      text eol=lf
LICENSE     text eol=lf

# Git hooks are executed as scripts — extensionless, so match the dir.
# A CRLF hook fails with "bad interpreter: /usr/bin/env bash^M".
.githooks/** text eol=lf
# launchd reads plists fine either way, but keep them LF for clean diffs.
*.plist     text eol=lf

# Windows-specific scripts keep their native CRLF.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binaries — never normalize.
*.png       binary
*.jpg       binary
*.gif       binary
*.exe       binary
*.dll       binary
