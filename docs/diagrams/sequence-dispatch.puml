@startuml sequence-dispatch
title Requirement Intake → Story Dispatch

actor User
participant "vxd CLI" as CLI
participant "Planner\n(Tech Lead LLM)" as PL
participant "Dispatcher" as DP
participant "Executor" as EX
participant "Runtime" as RT
participant "tmux" as TM
participant "Agent" as AG
participant "Monitor" as MON
database "events.jsonl" as EV
database "SQLite" as DB

User -> CLI : vxd req "requirement"
CLI -> CLI : buildPlanningClient\n(Claude CLI first, API fallback)
CLI -> PL : Plan(requirement)
PL -> EV : REQ_SUBMITTED
PL -> PL : decompose +\nFibonacci complexity scoring
PL -> EV : STORY_CREATED (×N)
PL -> EV : REQ_PLANNED
EV -> DB : project

User -> CLI : vxd resume <req-id>
CLI -> DP : DispatchWave (first wave)
loop per ready story
    DP -> DP : route by complexity\n(junior/intermediate/senior)
    DP -> EV : AGENT_SPAWNED, STORY_ASSIGNED
    CLI -> EX : execute(assignment)
    EX -> EX : git worktree + branch
    EX -> RT : Spawn(session config)
    RT -> RT : write CLAUDE.md + AGENTS.md\ninto the worktree
    RT -> TM : create session
    TM -> AG : start agent with prompt file
    EX -> EV : STORY_STARTED
end

EV -> DB : project
CLI -> MON : start poll loop
MON -> DP : dispatchNextWave\n(every later wave)

@enduml
