# Nginx reverse proxy for VXD dashboard (Phase 2).
#
# Use case: expose `vxd dashboard --web` on a public hostname with TLS.
# Place this file in /etc/nginx/sites-available/ and symlink into sites-enabled/.
#
# Assumes:
#   - vxd dashboard --web --port 8787 is running on the same host
#   - TLS cert at /etc/letsencrypt/live/vxd.example.com/
#   - Basic auth file at /etc/nginx/.htpasswd (htpasswd -c .htpasswd <user>)

server {
    listen 80;
    server_name vxd.example.com;

    # Redirect all HTTP to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name vxd.example.com;

    # TLS — use certbot to provision
    ssl_certificate     /etc/letsencrypt/live/vxd.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vxd.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # Hide server version
    server_tokens off;

    # Basic auth — VXD dashboard has no built-in auth in Phase 2
    auth_basic           "VXD Dashboard";
    auth_basic_user_file /etc/nginx/.htpasswd;

    # Health endpoint should be unauthenticated for Prometheus/uptime checks
    location = /health {
        auth_basic off;
        proxy_pass http://127.0.0.1:8787;
        access_log off;
    }

    # WebSocket support for live state updates
    location /ws {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 24h;  # keep WS open
    }

    # Everything else (static files, API)
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Reasonable timeouts for dashboard interactions
        proxy_connect_timeout 10s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;
    }

    # Logging
    access_log /var/log/nginx/vxd.access.log;
    error_log  /var/log/nginx/vxd.error.log warn;
}
