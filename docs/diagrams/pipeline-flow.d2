direction: right

title: Requirement → Stories → Merge Pipeline {
  shape: text
  style.font-size: 22
  style.bold: true
}

req: vxd req\n"requirement" {
  shape: oval
}

techlead: TechLead\ndecompose {
  style.fill: "#fef3c7"
}

stories: Stories\n(Fibonacci 1,2,3,5,8) {
  shape: cylinder
}

dispatch: Dispatcher\n(tier by role) {
  style.fill: "#fef3c7"
}

worktree: Worktree per story\ngit worktree add {
  shape: package
}

tmux: tmux session\nspawn agent {
  shape: package
}

agent: Agent (runtime CLI)\nimplement {
  style.fill: "#dcfce7"
}

monitor: Monitor\n10s poll {
  shape: parallelogram
}

review: Code Review\nLLM diff analysis {
  style.fill: "#fef3c7"
}

qa: QA\nbuild + test + criteria {
  style.fill: "#fef3c7"
}

security: Security Gate\nscanners + LLM review {
  style.fill: "#fef3c7"
}

paused: Requirement paused\n(human decision) {
  style.fill: "#fee2e2"
}

merge: Merger\nrebase → re-QA → push → PR → squash-merge {
  style.fill: "#fef3c7"
}

cleanup: Monitor cleanup\nremove worktree + branches {
  shape: parallelogram
}

done: Requirement complete {
  shape: oval
  style.fill: "#dcfce7"
}

escalate: Reset to draft /\nescalation chain (5 tiers) {
  style.fill: "#fee2e2"
}

req -> techlead
techlead -> stories
stories -> dispatch
dispatch -> worktree
worktree -> tmux
tmux -> agent
agent -> monitor: session done
monitor -> review: STORY_COMPLETED
review -> qa: pass
review -> escalate: fail
qa -> security: pass
qa -> escalate: fail
security -> merge: pass
security -> paused: finding
merge -> cleanup
merge -> escalate: fail
cleanup -> dispatch: next wave
cleanup -> done
escalate -> dispatch: retry / re-plan
