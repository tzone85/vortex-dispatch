@startuml sequence-escalation
title Failure Reset and Escalation: Tier 0 → Tier 4

participant "Monitor" as MN
participant "EscalationMachine" as ES
participant "Dispatcher" as DP
participant "Manager" as MG
participant "Planner\n(Tech Lead)" as TL
database "events.jsonl" as EV

MN -> MN : failure after execution:\nno diff, conflict markers, review,\nQA, rebase/pre-merge QA, PR/merge, timeout
MN -> ES : ShouldEscalate(story)

alt retries left at current tier
    MN -> EV : STORY_REVIEW_FAILED (reason) → draft
    note right : every reset uses STORY_REVIEW_FAILED,\nwhatever stage failed
    DP -> DP : re-dispatch at same tier\n(smart-retry hint in prompt)
else tier limit reached, next tier < 4
    MN -> EV : STORY_ESCALATED (from_tier, to_tier)
    MN -> EV : STORY_REVIEW_FAILED → draft
    alt tier 1
        DP -> DP : re-dispatch at senior tier
    else tier 2 (next wave)
        MN -> MG : Diagnose
        alt retry
            MG -> EV : STORY_ESCALATED (reset tier)\n+ STORY_REVIEW_FAILED
        else rewrite
            MG -> EV : STORY_REWRITTEN
        else split
            MG -> EV : STORY_CREATED (children)\n+ STORY_SPLIT
        else escalate_to_techlead
            MG -> EV : STORY_ESCALATED (to tier 3)
        end
    else tier 3 (next wave)
        MN -> TL : RePlan(story, failure context)
        TL -> EV : STORY_CREATED (children)\n+ STORY_SPLIT
    end
else next tier >= 4
    MN -> EV : REQ_PAUSED
    note right : no story event;\nstory status unchanged
end

@enduml
